shamefully-hoist=true
store-dir=.pnpm-store
# @marktext/file-icons 依赖 github:file-icons/atom；强制 HTTPS 避免 git+ssh 主机密钥校验失败
github-protocol=https
# Electron 二进制下载镜像（@electron/get 读取 electron_mirror / ELECTRON_MIRROR）
electron_mirror=https://npmmirror.com/mirrors/electron/
fetch-retries=8
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000
network-concurrency=4
msvs_version=2026
clang=0
block-exotic-subdeps=false
# Forces electron/rebuild to use gcc/g++ instead of clang on Linux and msvc on Windows
